# Copy to .env.local (development) or set these in your hosting provider (production).
# The lead form emails every submission through this SMTP account.
# Until these are set, the form falls back to opening the visitor's email app.

LEAD_SMTP_HOST=smtp.example.com
LEAD_SMTP_PORT=587
LEAD_SMTP_USER=leads@mindlox.ai
LEAD_SMTP_PASS=your-smtp-password

# Where submissions are delivered (defaults to info@mindlox.ai).
LEAD_TO=info@mindlox.ai
# The sender shown on the notification (defaults to LEAD_SMTP_USER).
LEAD_FROM=leads@mindlox.ai
